{
    "name":  "electron-office",
    "version":  "3.6.1",
    "description":  "Electron离线办公工具软件",
    "main":  "./dist-electron/main/index.js",
    "author":  "Your Name",
    "license":  "MIT",
    "scripts":  {
                    "generate-icon":  "node scripts/generate-icon.js",
                    "dev":  "vite",
                    "build":  "npm run generate-icon \u0026\u0026 vite build \u0026\u0026 electron-builder --config electron-builder.config.js",
                    "build:dir":  "npm run generate-icon \u0026\u0026 vite build \u0026\u0026 electron-builder --win --dir --config electron-builder.config.js",
                    "build:nsis":  "npm run generate-icon \u0026\u0026 vite build \u0026\u0026 electron-builder --win nsis --config electron-builder.config.js",
                    "release":  "npm run generate-icon \u0026\u0026 powershell -ExecutionPolicy Bypass -File build-release.ps1",
                    "release:minor":  "npm run generate-icon \u0026\u0026 powershell -ExecutionPolicy Bypass -File build-release.ps1 minor",
                    "release:major":  "npm run generate-icon \u0026\u0026 powershell -ExecutionPolicy Bypass -File build-release.ps1 major",
                    "preview":  "vite preview",
                    "start":  "electron ."
                },
    "dependencies":  {
                         "exceljs":  "^4.4.0",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.11.16",
                            "@types/react":  "^18.2.55",
                            "@types/react-dom":  "^18.2.19",
                            "@vitejs/plugin-react":  "^4.2.1",
                            "autoprefixer":  "^10.4.17",
                            "electron":  "^29.4.6",
                            "electron-builder":  "^24.13.3",
                            "jimp":  "^1.6.1",
                            "png-to-ico":  "^3.0.2",
                            "postcss":  "^8.4.35",
                            "sharp":  "^0.35.3",
                            "tailwindcss":  "^3.4.1",
                            "typescript":  "^5.3.3",
                            "vite":  "^5.1.0",
                            "vite-plugin-electron":  "^0.28.0",
                            "vite-plugin-electron-renderer":  "^0.14.0"
                        }
}

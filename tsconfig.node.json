{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "src-electron/main/**/*",
    "src-electron/preload/**/*"
  ]
}
